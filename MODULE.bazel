module(
    name = "ocp-diag-core-cpp",
    version = "",
    repo_name = "ocpdiag",
)

# Core dependencies (sorted alphabetically)
bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "grpc", version = "1.78.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "protobuf", version = "33.5", repo_name = "com_google_protobuf")
bazel_dep(name = "pybind11_bazel", version = "3.0.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "1.0.0")

# Dev dependencies (only needed for development/testing, sorted alphabetically)
bazel_dep(name = "googletest", version = "1.15.2", dev_dependency = True, repo_name = "com_google_googletest")

# Non-BCR dependencies via module extension
non_bcr_deps = use_extension("//ocpdiag:extensions.bzl", "non_bcr_deps")
use_repo(non_bcr_deps, "six_archive")
